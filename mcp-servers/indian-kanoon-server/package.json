{
	"name": "indian-kanoon-server",
	"version": "0.1.0",
	"description": "MCP server for Indian Kanoon legal database API",
	"type": "module",
	"main": "build/index.js",
	"bin": {
		"indian-kanoon-server": "build/index.js"
	},
	"scripts": {
		"build": "tsc && node -e \"require('fs').chmodSync('build/index.js', '755')\"",
		"prepare": "npm run build",
		"watch": "tsc --watch"
	},
	"keywords": [
		"mcp",
		"indian-kanoon",
		"legal",
		"api"
	],
	"author": "",
	"license": "MIT",
	"dependencies": {
		"@modelcontextprotocol/sdk": "^0.5.0",
		"axios": "^1.6.0"
	},
	"devDependencies": {
		"@types/node": "^20.0.0",
		"typescript": "^5.3.0"
	}
}
