# [scripts]

# Cline Startup Script
start = "bash start.sh"
modules = ["nodejs-20", "go-1.21"]

[env]
INDIANKANOON_API_TOKEN = "98394cdd9c5f1467cd6e43d9a57a2174c019f49d"

[agent]
expertMode = true

[[ports]]
localPort = 5000
externalPort = 5000

[[ports]]
localPort = 8001
externalPort = 3000

[[ports]]
localPort = 25463
externalPort = 3001

[[ports]]
localPort = 26041
externalPort = 80

[[ports]]
localPort = 37957
externalPort = 3003

[nix]
channel = "stable-25_05"
packages = ["lsof", "vim-full", "chromium", "chromedriver", "nss", "alsa-lib", "at-spi2-atk", "gtk3", "mesa", "xorg.libX11", "xorg.libxcb", "xorg.libXScrnSaver", "cacert", "liberation_ttf", "xdg-utils"]

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Cline Services"

[[workflows.workflow]]
name = "Cline Services"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "bash start-cline-replit.sh"
waitForPort = 5000

[workflows.workflow.metadata]
outputType = "webview"

[deployment]
deploymentTarget = "autoscale"
run = ["bash", "start-cline-production.sh"]
