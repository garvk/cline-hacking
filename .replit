start = "bash start.sh"
modules = ["nodejs-20", "go-1.21"]


[agent]
expertMode = true

[[ports]]
localPort = 5000
externalPort = 80

[[ports]]
localPort = 8001
externalPort = 3001

[[ports]]
localPort = 26041
externalPort = 3000


[nix]
channel = "stable-25_05"
packages = ["lsof"]

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Cline Services"

[[workflows.workflow]]
name = "Cline Services"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "bash start-cline-replit.sh"
waitForPort = 5000

[workflows.workflow.metadata]
outputType = "webview"

# [deployment]
# deploymentTarget = "vm"
# run = ["bash", "start-cline-production.sh"]

# deploymentTarget = "autoscale"
# build = ["npm", "run", "build"]
# run = ["bash", "start-cline-production.sh"]

# [deployment]
# deploymentTarget = "vm"
# run = ["bash", "start-cline-production.sh"]

[deployment]
deploymentTarget = "autoscale"
build = ["bash", "build-deployment.sh"]
run = ["bash", "start-cline-production.sh"]
ignorePorts = false
ignorePaths = [
  "node_modules",
  ".git",
  ".cache",
  "src",
  "webview-ui/src",
  "dist-standalone-temp",
  "*.log",
  "*.map",
]
